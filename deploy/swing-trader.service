# Swing/scalp trader variant — see regime-trader.service for full setup notes.

[Unit]
Description=Ethereal Capital — Swing/Scalp Trader (ETH only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu                                                      # EDIT
WorkingDirectory=/home/ubuntu/hyperliquid-bot
ExecStart=/home/ubuntu/hyperliquid-bot/.venv/bin/python paper_trade.py
Restart=on-failure
RestartSec=30
StandardOutput=append:/home/ubuntu/hyperliquid-bot/stdout-swing.log
StandardError=append:/home/ubuntu/hyperliquid-bot/stderr-swing.log
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
